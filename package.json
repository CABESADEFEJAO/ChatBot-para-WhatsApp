{
  "name": "whatsapp-pdf-scanner",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "WhatsApp PDF Scanner - Bot de Download de Currículos",
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^26.8.1",
    "jest": "^30.4.2"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "database/**/*.js",
      "services/**/*.js",
      "bot-service.js"
    ],
    "testMatch": [
      "**/tests/unit/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.21.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "build": {
    "appId": "com.whatsapp.pdfscanner",
    "productName": "WhatsApp PDF Scanner",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "bot-service.js",
      "index.html",
      "renderer.js",
      "preload.js",
      "node_modules/**"
    ],
    "win": {
      "target": "portable"
    }
  }
}
